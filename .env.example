# Copy this file to .env and adjust values before running docker compose.
# Never commit the real .env file.

# --- Database ---
MYSQL_ROOT_PASSWORD=rootpass
DB_NAME=cslm
DB_USERNAME=cslm
DB_PASSWORD=cslm

# --- SMTP (defaults point to the bundled MailHog dev SMTP server) ---
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=cslm-noreply@example.com

# --- Security ---
JWT_SECRET=change-this-super-secret-key-for-cslm-please-override-in-prod-0123456789
JWT_EXPIRATION_MINUTES=480
# NOTE: CORS is wide open in SecurityConfig for this PoC (allows any origin).
# Lock it down to specific origins before any non-PoC deployment.

# --- Notifications ---
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_CRON=0 0 7 * * *
