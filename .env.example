# Copy this file to .env and adjust values before running docker compose.
# Never commit the real .env file.

# --- Database ---
MYSQL_ROOT_PASSWORD=rootpass
DB_NAME=cslm
DB_USERNAME=cslm
DB_PASSWORD=cslm

# --- SMTP (defaults point to the bundled MailHog dev SMTP server) ---
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=cslm-noreply@example.com

# --- Security ---
JWT_SECRET=change-this-super-secret-key-for-cslm-please-override-in-prod-0123456789
JWT_EXPIRATION_MINUTES=480

# --- CORS (comma separated origins allowed to call the API) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Notifications ---
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_CRON=0 0 7 * * *
